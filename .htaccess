# Cros Escolar La Granada — configuració per a servidors Apache / LiteSpeed
# (a CloudPanel amb nginx cal fer servir el bloc de docs/nginx.conf)

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Força HTTPS si el servidor l'ofereix
    # RewriteCond %{HTTPS} !=on
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

    # Fitxers i carpetes existents es serveixen directament
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # La resta va al controlador frontal
    RewriteRule ^ index.php [L]
</IfModule>

# Bloqueig de carpetes internes
RedirectMatch 404 ^/(app|storage)/.*$
RedirectMatch 404 ^/\.git

<FilesMatch "\.(sql|log|lock|md|json|dist|sample)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 30 days"
    ExpiresByType application/javascript "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

Options -Indexes
